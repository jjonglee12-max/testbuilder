{
  "name": "ai-blog-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "desktop": "npm run build && electron .",
    "build": "vite build",
    "test": "node --test tests/*.test.cjs",
    "package:win": "npm run build && electron-builder --win zip"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "vite": "^7.3.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "kr.aiblog.studio",
    "productName": "AI Blog Studio",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "prompts/**/*"
    ],
    "win": {
      "target": "zip",
      "signAndEditExecutable": false
    },
    "directories": {
      "output": "release"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
